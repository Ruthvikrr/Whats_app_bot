# Server Port
PORT=3000
NODE_ENV=production

# Meta Webhook Verification Token (A random secure string you create and configure in Meta App Dashboard)
META_VERIFY_TOKEN=MySecretWebhookToken_2026!#

# WhatsApp Cloud API Permanent System User Token
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here

# WhatsApp Phone Number ID (From WhatsApp > API Setup in Meta App Dashboard)
WHATSAPP_PHONE_NUMBER_ID=1260489390490394

# Meta App ID (From App Dashboard Settings > Basic)
META_APP_ID=1113607347793938

# Meta App Secret (From App Dashboard Settings > Basic)
META_APP_SECRET=your_meta_app_secret_here

# Meta Graph API Version (e.g., v21.0, v22.0)
META_GRAPH_API_VERSION=v21.0

# Public Domain / URL where your server is hosted (e.g., https://your-domain.com or VPS URL)
PUBLIC_APP_URL=https://your-domain.com

# Admin Authentication (Email + Password for /dashboard and client portals)
ADMIN_EMAIL=admin@triuss.com
ADMIN_PASSWORD=change_this_secure_password_123
SESSION_SECRET=a_very_long_secure_random_session_secret_key
